<?xml version="1.0" encoding="utf-8"?><!--
   Backup / device-to-device transfer rules for API 31+ (API < 31 uses backup_rules.xml — keep the two
   in sync). Same whitelist for both channels: ONLY these preference files leave the device.

   Deliberately NOT included (see backup_rules.xml for the reasoning):
     * "<applicationId>_preferences.xml" — the Supabase session (access + refresh token);
     * the Room database "brickwares.db" and the sync-cursor DataStore — rebuilt by sync after sign-in;
     * brickwares_install.xml, fx_rates.xml, Firebase / Crashlytics / WorkManager state.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="brickwares_currency.xml" />
        <include domain="sharedpref" path="brickwares_locale.xml" />
        <include domain="sharedpref" path="brickwares_analytics.xml" />
        <include domain="sharedpref" path="brickwares_rate.xml" />
        <include domain="sharedpref" path="brickwares_retirement_alerts.xml" />
        <include domain="sharedpref" path="brickwares_theme_favorites.xml" />
        <include domain="sharedpref" path="brickwares_account.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="brickwares_currency.xml" />
        <include domain="sharedpref" path="brickwares_locale.xml" />
        <include domain="sharedpref" path="brickwares_analytics.xml" />
        <include domain="sharedpref" path="brickwares_rate.xml" />
        <include domain="sharedpref" path="brickwares_retirement_alerts.xml" />
        <include domain="sharedpref" path="brickwares_theme_favorites.xml" />
        <include domain="sharedpref" path="brickwares_account.xml" />
    </device-transfer>
</data-extraction-rules>
