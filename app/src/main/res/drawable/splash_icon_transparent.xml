<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent icon for the Android-12 system splash: the OS always draws a system splash
     before the first app frame, and by default it centers the launcher brick. Making the icon
     invisible leaves only the brand background (windowSplashScreenBackground), so the brick appears
     just once — animating in on the Compose SplashScreen that follows. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
