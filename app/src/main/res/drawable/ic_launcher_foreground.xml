<?xml version="1.0" encoding="utf-8"?>
<!--
  BrickWares logo, centered within the adaptive-icon safe zone (108dp canvas).
  Sized to 78dp so the full brick-on-shelf composition sits inside the launcher's
  circular mask (the shortened shelf leaves room to size it up a little).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="78dp"
        android:height="78dp"
        android:gravity="center"
        android:drawable="@drawable/brickwares_launcher" />
</layer-list>
