# BrickWares local ingestion secrets — COPY this file to `.env.local` and fill in.
# `.env.local` is gitignored; never commit real keys, and don't paste them into chat.
#
# Usage:
#   node --env-file=supabase/.env.local scripts/fetch-catalog.mjs
#   supabase db reset      # applies migrations + the generated seed.sql

# --- Brickset (sets) --- https://brickset.com/tools/webservices/v3
BRICKSET_API_KEY=

# Brickset auth: EITHER paste a userHash you already have (preferred — no password stored),
# OR give username+password and the script logs in to fetch a userHash for you.
BRICKSET_USER_HASH=
BRICKSET_USERNAME=
BRICKSET_PASSWORD=

# What to pull: comma-separated Brickset theme names, and newest-N per theme.
BRICKSET_THEMES=Architecture,Batman,Icons,Technic,Ninjago,Star Wars
BRICKSET_PAGESIZE=20

# Themes pulled COMPLETELY — every set across all pages, any availability (retired included), not just
# the newest few. Use to bring a whole theme into the catalog (e.g. all DC Comics Super Heroes sets).
# Runs on every fetch so these themes stay fully covered. BRICKSET_FULL_MINIFIGS=1 also pulls their
# minifigs (slow — a whole theme is many Rebrickable calls); off = full-theme sets are catalog-only.
BRICKSET_FULL_THEMES=DC Comics Super Heroes
BRICKSET_FULL_PAGESIZE=100
BRICKSET_FULL_MINIFIGS=0

# Extra pass: also pull OLD RETIRED sets (for testing the retired badge/value flows). Added to the
# sets + set_prices catalog but NOT sent to the Rebrickable minifig fetch. Set BRICKSET_RETIRED=0 to skip.
BRICKSET_RETIRED=1
BRICKSET_RETIRED_YEARS=2014,2015,2016,2017,2018,2019,2020
BRICKSET_RETIRED_THEMES=Star Wars,Technic,City,Ninjago,Creator Expert,Architecture,Ideas,Marvel Super Heroes,Harry Potter,Speed Champions
BRICKSET_RETIRED_PAGESIZE=40
BRICKSET_RETIRED_MAX=200

# "Full picture" theme coverage: pull BRICKSET_ALL_THEMES_SAMPLE sets (default 1) for EVERY Brickset
# theme via getThemes, so all ~173 themes appear in the theme browse. Runs on every fetch (catalog-only,
# no minifigs); set BRICKSET_ALL_THEMES=0 to skip.
BRICKSET_ALL_THEMES=1
BRICKSET_ALL_THEMES_SAMPLE=1
# Fast focused run: fetch ONLY the theme samples and merge into the existing seed.sql (skips the
# primary/full/retired/minifig/translate passes; implies append). Fills in missing themes quickly.
# Usage:  BRICKSET_SAMPLES_ONLY=1 BRICKSET_APPEND=1 node --env-file=supabase/.env.local scripts/fetch-catalog.mjs
BRICKSET_SAMPLES_ONLY=

# --- Rebrickable (minifigs) --- https://rebrickable.com/api/  (used in a later pass)
REBRICKABLE_API_KEY=

# --- Google sign-in for the LOCAL Supabase stack ---
# Referenced by supabase/config.toml [auth.external.google] via env(). The CLI reads these from a
# gitignored `supabase/.env` (auto-loaded) OR from your shell env before `supabase start` / `db reset`.
# CLIENT_ID = the "Web" OAuth client id (the app's ID-token audience); SECRET = its client secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Resend SMTP for the LOCAL Supabase stack ---
# Referenced by supabase/config.toml [auth.email.smtp] via env(), read from the gitignored
# supabase/.env (auto-loaded by the CLI). Create a "Sending" API key at resend.com (starts with re_),
# ideally restricted to the brickwares.app domain. Leave blank to fall back to the Mailpit test inbox
# (set enabled = false in the config.toml [auth.email.smtp] block for offline / no-quota dev).
RESEND_API_KEY=
